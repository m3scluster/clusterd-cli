Output demo/clusterd-cli-demo.mp4

Set Shell "bash"
Set FontSize 20
Set Width 1280
Set Height 720
Set Padding 28
Set TypingSpeed 25ms
Set Theme { "background": "#08111f", "foreground": "#d8e7ff", "cursor": "#ef4444", "black": "#08111f", "red": "#ef4444", "green": "#22c55e", "yellow": "#fbbf24", "blue": "#3b82f6", "magenta": "#a78bfa", "cyan": "#22d3ee", "white": "#f8fafc", "brightBlack": "#475569", "brightRed": "#f87171", "brightGreen": "#4ade80", "brightYellow": "#fde047", "brightBlue": "#60a5fa", "brightMagenta": "#c4b5fd", "brightCyan": "#67e8f9", "brightWhite": "#ffffff" }

Type "DEMO_DELAY=1.7 bash demo/demo.sh"
Enter
Sleep 18s
